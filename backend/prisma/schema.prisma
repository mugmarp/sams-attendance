generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
  STUDENT
  EXAMINER
  ADMIN
}
enum SessionType {
  LECTURE
  TUTORIAL
  PRACTICAL
  LAB
  CLINICAL
}
enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
enum CheckInMethod {
  CODE
  MANUAL
}
model User {
  id String @id @default(cuid())
  email String @unique
  isActive Boolean @default(true)
  passwordHash String
  role UserRole @default(STUDENT)
  regNo String? @unique
  name String
  program String?
  year Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  examinerCourses Course[]
  enrollments Enrollment[]
  attendances Attendance[]
  changes AttendanceChange[]
  preparations OfflinePreparation[]
  receipts SyncReceipt[]
  claims AttendanceClaim[] @relation("ClaimStudent")
  decisions AttendanceClaim[] @relation("ClaimReviewer")
}
model Course {
  id String @id @default(cuid())
  code String
  title String
  creditUnits Int @default(3)
  program String
  year Int
  semester Int
  attendanceThreshold Int @default(80)
  academicYear String
  examinerId String
  examiner User @relation(fields: [examinerId], references: [id])
  sessions Session[]
  enrollments Enrollment[]
  @@unique([code, academicYear, semester])
}
model Session {
  id String @id @default(cuid())
  version Int @default(1)
  naturalKey String @unique
  courseId String
  course Course @relation(fields: [courseId], references: [id])
  startTime DateTime
  endTime DateTime
  room String?
  sessionType SessionType @default(LECTURE)
  status SessionStatus @default(SCHEDULED)
  checkinSecret String?
  checkinStartedAt DateTime?
  checkinClosesAt DateTime?
  attendances Attendance[]
  preparations OfflinePreparation[]
  claims AttendanceClaim[]
  @@index([courseId, startTime])
}
model Enrollment {
  id String @id @default(cuid())
  studentId String
  student User @relation(fields: [studentId], references: [id])
  courseId String
  course Course @relation(fields: [courseId], references: [id])
  @@unique([studentId, courseId])
}
model Attendance {
  id String @id @default(cuid())
  studentId String
  student User @relation(fields: [studentId], references: [id])
  sessionId String
  session Session @relation(fields: [sessionId], references: [id])
  version Int @default(1)
  status AttendanceStatus @default(PRESENT)
  method CheckInMethod @default(CODE)
  recordedAt DateTime @default(now())
  changes AttendanceChange[]
  @@unique([studentId, sessionId])
}
model AttendanceChange {
  id String @id @default(cuid())
  attendanceId String
  attendance Attendance @relation(fields: [attendanceId], references: [id])
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  operationId String? @db.Uuid
  previousStatus AttendanceStatus?
  status AttendanceStatus
  reason String
  recordedAt DateTime @default(now())
}

model OfflinePreparation {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  sessionId String
  session Session @relation(fields: [sessionId], references: [id])
  purpose String
  snapshot Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([actorId, sessionId])
}
model SyncReceipt {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  operationId String @db.Uuid
  payloadHash String
  payload Json
  result Json
  receivedAt DateTime @default(now())
  @@unique([actorId, operationId])
}
enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}
model AttendanceClaim {
  id String @id @default(cuid())
  studentId String
  student User @relation("ClaimStudent", fields: [studentId], references: [id])
  sessionId String
  session Session @relation(fields: [sessionId], references: [id])
  reason String
  status ClaimStatus @default(PENDING)
  version Int @default(1)
  createdAt DateTime @default(now())
  reviewerId String?
  reviewer User? @relation("ClaimReviewer", fields: [reviewerId], references: [id])
  decisionReason String?
  decidedAt DateTime?
  @@unique([studentId, sessionId])
  @@index([sessionId, status])
}
