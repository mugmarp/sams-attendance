{
  "info": {
    "name": "SAMS Attendance Prototype",
    "description": "Use the disposable demo seed. Run role logins first, then choose a scheduled class. Complete and cancel are alternative actions; do not run blindly against real records. Attendance qualification is not final examination clearance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "password",
      "value": "SamsDemo2026!",
      "type": "string"
    },
    {
      "key": "examinerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "courseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "code",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Database health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Sign in as examiner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"examiner@demo.sams.test\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set('examinerToken', data.accessToken); pm.collectionVariables.set('refreshToken', data.refreshToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign in as student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@demo.sams.test\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set('studentToken', data.accessToken); pm.collectionVariables.set('refreshToken', data.refreshToken); pm.collectionVariables.set('studentId', data.user.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign in as admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@demo.sams.test\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set('adminToken', data.accessToken); pm.collectionVariables.set('refreshToken', data.refreshToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh current token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Current student profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Today\u2019s examiner classes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/examiner/sessions/today",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{examinerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { const item = pm.response.json().find(s => s.status === 'SCHEDULED'); if (item) { pm.collectionVariables.set('sessionId', item.id); pm.collectionVariables.set('courseId', item.courseId); } }"
            ]
          }
        }
      ]
    },
    {
      "name": "Class details and current code",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/examiner/sessions/{{sessionId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{examinerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Open check-in window",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/examiner/sessions/{{sessionId}}/start-checkin",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{examinerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set('code', pm.response.json().code);"
            ]
          }
        }
      ]
    },
    {
      "name": "Student\u2019s available classes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/student/sessions/upcoming",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Record student check-in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/student/checkin",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"code\": \"{{code}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Class roster and correction history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/examiner/sessions/{{sessionId}}/attendance",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{examinerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Correct attendance (requires reason)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/examiner/sessions/{{sessionId}}/attendance",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{examinerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"status\": \"LATE\",\n  \"reason\": \"Verified against the classroom register\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Student\u2019s course summaries",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/student/attendance/summary",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Admin course offerings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/courses",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Admin student list",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/students",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Course attendance qualification",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/eligibility/{{courseId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Download prototype attendance PDF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/eligibility/{{courseId}}/pdf",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Close check-in window",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/examiner/sessions/{{sessionId}}/stop-checkin",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{examinerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Complete class (irreversible state transition)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/examiner/sessions/{{sessionId}}/complete",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{examinerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Cancel a scheduled class (alternative to completion)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/examiner/sessions/{{sessionId}}/cancel",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{examinerToken}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
