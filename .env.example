# Compose configuration. Use URL-safe random values, for example openssl rand -hex 32.
DB_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-32-characters
FRONTEND_URL=http://localhost:5173

# Optional loopback ports if the defaults are occupied.
DB_PORT=5432
FRONTEND_PORT=5173

# Keep 0 for direct Express access; use 1 behind one trusted reverse proxy.
TRUST_PROXY=0
